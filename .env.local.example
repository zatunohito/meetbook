# Supabase（Project Settings → API）
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role キーはサーバー専用。絶対に NEXT_PUBLIC_ を付けない・公開しないこと
SUPABASE_SERVICE_ROLE_KEY=

# 試走用セッション Cookie の署名鍵（任意・32文字以上。未設定なら service_role キーから自動で導出）
# 生成例: openssl rand -base64 48
SESSION_SECRET=

# 管理画面（/admin）の Basic 認証。パスワードは12文字以上。未設定なら管理画面は無効
ADMIN_USER=admin
ADMIN_PASSWORD=
